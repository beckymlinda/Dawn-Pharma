APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nightly database backup (php artisan backup:database). Comma-separate several addresses.
BACKUP_EMAIL=
BACKUP_KEEP_DAYS=14

# Business details used until they are filled in under Settings (each client edits them there)
BUSINESS_NAME="${APP_NAME}"
BUSINESS_LOCATION=
BUSINESS_TELEPHONE=
BUSINESS_EMAIL=
BUSINESS_TAX_NUMBER=
RECEIPT_FOOTER="Thank you for your purchase!"
POWERED_BY="Dawn Pharma"

# Multiple shops (see config/tenancy.php). Each shop is opened at APP_URL/{slug}, e.g. /area25.
# Shop used when a browser has not opened a shop link yet; leave empty to ask for the Shop code.
TENANCY_DEFAULT_SLUG=
# Slug given to the data already in this installation when upgrading to multiple shops
TENANCY_FIRST_SLUG=area25
TENANCY_GRACE_DAYS=7
# Turns on APP_URL/setup?token=... (run migrations, create the first platform admin). 16+ characters; remove when done.
PLATFORM_SETUP_TOKEN=

# Shown to shops on their Billing page and when the system is blocked
BILLING_CONTACT_NAME="Dawn Pharma"
BILLING_CONTACT_PHONE=
BILLING_CONTACT_EMAIL=
BILLING_PAY_TO=

# Who is emailed when a shop uploads proof of payment (payment accounts are in config/tenancy.php)
BILLING_NOTIFY_EMAIL=beckymlinda@gmail.com

# SMS (Z report by text). Get a key at https://devs.tumasend.com
SMS_DRIVER=tumasend
TUMASEND_API_KEY=
TUMASEND_FROM=TumaSend
TUMASEND_WEBHOOK_SECRET=
